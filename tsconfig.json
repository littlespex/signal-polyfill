{
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "pretty": true,
    "moduleResolution": "node",
    "module": "ESNext",
    "target": "ES2019",
    "useDefineForClassFields": false,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noEmitOnError": false,
    "lib": ["DOM", "ES2019"],
    "strict": true,
    "composite": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true
  },
  "exclude": ["**/node_modules/**", "**/*.spec.ts", "**/dist/**/*"],
  "include": ["src"]
}
